<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>cc.true-love.sync.macair</string>

  <key>ProgramArguments</key>
  <array>
      <string>/opt/homebrew/bin/bun</string>
      <string>run</string>
      <string>/Users/macair/Desktop/true-love/bin/sync.mjs</string>
      <string>--quiet</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/macair/Desktop/true-love</string>

  <key>StartInterval</key>
  <integer>300</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/macair/Library/Logs/true-love/sync.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/macair/Library/Logs/true-love/sync.err.log</string>

  <key>ProcessType</key>
  <string>Background</string>

  <key>Nice</key>
  <integer>10</integer>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/local/bin</string>
  </dict>
</dict>
</plist>
